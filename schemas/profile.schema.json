{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobbot-skill:schema:profile",
  "title": "JobBot candidate profile",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "work_authorization",
    "summary_facts",
    "experience",
    "education",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        2,
        3
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "email",
        "phone",
        "location",
        "residence_country",
        "links"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "residence_country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "work_authorization": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "country",
          "status",
          "requires_sponsorship",
          "source_ids"
        ],
        "properties": {
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "status": {
            "type": "string"
          },
          "requires_sponsorship": {
            "type": "boolean"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "summary_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceText"
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "employer",
          "title",
          "location",
          "start",
          "end",
          "source_ids",
          "bullets"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "employer": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidenceText"
            }
          },
          "related_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "institution",
          "credential",
          "location",
          "start",
          "end",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "credential": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "source_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experienceEntry"
      }
    },
    "research": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experienceEntry"
      }
    },
    "coursework": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experienceEntry"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experienceEntry"
      }
    }
  },
  "$defs": {
    "evidenceText": {
      "type": "object",
      "required": [
        "id",
        "text",
        "source_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "experienceEntry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "start",
        "end",
        "source_ids",
        "bullets"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "bullets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceText"
          }
        },
        "related_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 3
          }
        }
      },
      "then": {
        "required": [
          "projects",
          "research",
          "coursework",
          "activities"
        ]
      }
    }
  ]
}
