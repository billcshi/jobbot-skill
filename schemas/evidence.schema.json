{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobbot-skill:schema:evidence",
  "title": "Imported source manifest",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "label", "locator", "imported_at", "sha256", "ownership_confirmed"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["user_statement", "resume", "github", "portfolio", "certificate", "transcript", "other"] },
          "label": { "type": "string" },
          "locator": { "type": "string" },
          "imported_at": { "type": "string" },
          "sha256": { "type": "string" },
          "ownership_confirmed": { "type": "boolean" },
          "snapshot_directory": { "type": "string" },
          "attempt_directory": { "type": "string" },
          "snapshot_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" } },
          "coverage": {
            "type": "object",
            "required": ["pages_fetched", "max_pages", "repositories_saved", "complete", "next_page", "scope"],
            "properties": {
              "pages_fetched": { "type": "integer", "minimum": 1 },
              "max_pages": { "type": "integer", "minimum": 1, "maximum": 100 },
              "repositories_saved": { "type": "integer", "minimum": 0 },
              "complete": { "type": "boolean" },
              "next_page": { "type": ["integer", "null"], "minimum": 2 },
              "scope": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
