{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jobbot-skill:schema:resume",
  "title": "JobBot evidence-bound resume plan",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "market_sha256",
    "profile_sha256",
    "jd_sha256",
    "target_role",
    "summary",
    "experience",
    "education",
    "profile_skill_ids"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "job_id": {
      "type": "string"
    },
    "market_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "jd_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_role": {
      "type": "string"
    },
    "summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_experience_id",
          "bullets"
        ],
        "properties": {
          "profile_experience_id": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claim"
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_education_id"
        ],
        "properties": {
          "profile_education_id": {
            "type": "string"
          }
        }
      }
    },
    "profile_skill_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "writing_rules_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "section_order": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "summary",
          "experience",
          "projects",
          "research",
          "coursework",
          "activities",
          "education",
          "skills"
        ]
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_project_id",
          "bullets"
        ],
        "properties": {
          "profile_project_id": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claim"
            }
          }
        }
      }
    },
    "research": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_research_id",
          "bullets"
        ],
        "properties": {
          "profile_research_id": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claim"
            }
          }
        }
      }
    },
    "coursework": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_course_id",
          "bullets"
        ],
        "properties": {
          "profile_course_id": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claim"
            }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_activity_id",
          "bullets"
        ],
        "properties": {
          "profile_activity_id": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/claim"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "text",
        "evidence_ids"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "writing_rules_sha256",
          "projects",
          "research",
          "coursework",
          "activities"
        ]
      }
    }
  ]
}
